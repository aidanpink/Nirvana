{
  "schemaVersion": 1,
  "id": "nirvana",
  "version": "${version}",
  "name": "Nirvana",
  "description": "Unofficial Minecraft 26.1.1 Fabric source port of Team Galena Nirvana 2.0.11.",
  "authors": [
    "possible_triangle",
    "Team Galena"
  ],
  "contributors": [
    "aidanpink (26.1.1 port)"
  ],
  "contact": {
    "sources": "https://github.com/aidanpink/Nirvana/tree/port/26.1.1-fabric",
    "issues": "https://github.com/aidanpink/Nirvana/issues"
  },
  "license": "MIT (code); All Rights Reserved (upstream assets)",
  "environment": "*",
  "accessWidener": "nirvana.accesswidener",
  "entrypoints": {
    "main": [
      "galena.nirvana.fabric.FabricEntrypoint"
    ],
    "client": [
      "galena.nirvana.fabric.client.FabricClientEntrypoint"
    ],
    "jei_mod_plugin": [
      "galena.nirvana.fabric.compat.NirvanaJeiFabricPlugin"
    ]
  },
  "mixins": [
    "nirvana.mixins.json",
    "nirvana.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.145.4",
    "minecraft": "26.1.1",
    "java": ">=25",
    "forgeconfigapiport": ">=26.1.3"
  }
}
